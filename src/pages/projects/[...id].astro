---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={data.title} description={data.description}>
  <article class="article">
    <h1 class="page-title">{data.title}</h1>
    <p class="dek">{data.description}</p>
    <dl class="facts">
      <div>
        <dt class="label">Status</dt>
        <dd>{data.status}</dd>
      </div>
      <div>
        <dt class="label">Stack</dt>
        <dd>{data.stack.join(', ')}</dd>
      </div>
      {
        data.repo && (
          <div>
            <dt class="label">Code</dt>
            <dd>
              <a href={data.repo}>GitHub</a>
            </dd>
          </div>
        )
      }
      {
        data.url && (
          <div>
            <dt class="label">Live</dt>
            <dd>
              <a href={data.url}>{new URL(data.url).hostname}</a>
            </dd>
          </div>
        )
      }
    </dl>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .article {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .meta a {
    color: inherit;
  }
  .dek {
    font-size: 1.2rem;
    color: var(--muted);
    margin: var(--space-2) 0 var(--space-5);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0 0 var(--space-5);
    padding: var(--space-4);
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 4px solid var(--stripe);
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .facts dd {
    margin: 0.1rem 0 0;
    font-weight: 700;
  }
</style>
