---
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Things I've built, with what worked and what didn't.">
  <h1 class="page-title">Projects</h1>
  <p class="page-intro">Things I've built, written up with what worked, how I measured it, and what didn't.</p>
  <Panel title={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`}>
    <table>
      <thead>
        <tr>
          <th class="label" scope="col">Project</th>
          <th class="label" scope="col">Stack</th>
          <th class="label" scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        {
          projects.map((p) => (
            <tr>
              <td>
                <a class="title" href={`/projects/${p.id}`}>
                  {p.data.title}
                </a>
                <span class="desc">{p.data.description}</span>
              </td>
              <td class="stack">{p.data.stack.join(', ')}</td>
              <td>
                <span class:list={['label', 'status', p.data.status]}>{p.data.status}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Panel>
</Base>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    text-align: left;
    padding: 0 var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  tr:last-child td {
    border-bottom: 0;
  }
  .title {
    display: block;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--fg);
    text-decoration: none;
  }
  .title:hover {
    color: var(--link);
  }
  .desc {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .stack {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .status.shipped {
    color: var(--r-good);
  }
  .status.building {
    color: var(--r-mid);
  }
  @media (max-width: 36rem) {
    thead {
      display: none;
    }
    tr,
    td {
      display: block;
    }
    td {
      border: 0;
      padding: 0 0 var(--space-1);
    }
    tr {
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
