---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import { formatDate } from '../lib/content';
import { nowSchema } from '../content/schemas';
import nowData from '../data/now.json';

// Edited by hand or by the posting MCP server's update_now tool.
const now = nowSchema.parse(nowData);
---

<Base title="Now" description="What I'm focused on right now.">
  <div class="column">
    <h1 class="page-title">Now</h1>
    <p class="page-intro">
      Updated {formatDate(now.updated)}. A <a href="https://nownownow.com/about">now page</a>: what I'm focused on this
      month.
    </p>
    <Panel title="Current focus">
      <ul class="focus">
        {now.items.map((item) => <li>{item}</li>)}
      </ul>
    </Panel>
  </div>
</Base>

<style>
  .column {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .focus {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-2);
    font-size: 1.0625rem;
  }
  .focus li::marker {
    color: var(--stripe);
  }
</style>
