---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import Take from '../components/Take.astro';
import { getTakes } from '../lib/content';

const takes = await getTakes();
---

<Base title="Takes" description="Short thoughts on soccer, tech, and everything else.">
  <div class="column">
    <h1 class="page-title">Takes</h1>
    <p class="page-intro">Short, fast, occasionally wrong. The predictions get scored.</p>
    <Panel>
      {takes.map((take) => <Take take={take} />)}
    </Panel>
  </div>
</Base>

<style>
  .column {
    max-width: var(--measure);
    margin: 0 auto;
  }
</style>
