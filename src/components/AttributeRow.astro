---
import { band, bandRange, type Attribute } from '../data/profile';
import type { Evidence } from '../lib/content';

interface Props {
  attribute: Attribute;
  evidence: Evidence[];
  index: number;
}

const { attribute, evidence, index } = Astro.props;
const verified = evidence.length > 0;
const level = band(attribute.rating);
---

<li style={`--i: ${index}`}>
  <details>
    <summary>
      <span class="name">{attribute.name}</span>
      {
        verified ? (
          <span class:list={['rating', 'num', level]} aria-label={`${attribute.rating} out of 20`}>
            {attribute.rating}
          </span>
        ) : (
          <span
            class="rating num unverified"
            aria-label={`Unverified, somewhere between ${bandRange(attribute.rating)} out of 20`}
          >
            {bandRange(attribute.rating)}
          </span>
        )
      }
      <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2.5 7.5 6 4 9.5" /></svg>
    </summary>
    <div class="evidence">
      {
        verified ? (
          <ul>
            {evidence.map((e) => (
              <li>
                <span class="label">{e.kind}</span> <a href={e.href}>{e.title}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p>
            <span class="label flag">Unverified</span> No evidence on the site yet, so it shows as a range. Take
            it on trust, or don't.
          </p>
        )
      }
    </div>
  </details>
</li>

<style>
  li {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: 1fr auto 0.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .name {
    color: var(--link);
  }
  .name {
    font-size: 0.9375rem;
    transition: color 0.15s var(--ease);
  }
  .rating {
    font-stretch: 72%;
    font-weight: 800;
    font-size: 1.125rem;
    min-width: 1.6rem;
    text-align: right;
    animation: settle 0.9s var(--ease) both;
    animation-delay: calc(var(--i) * 40ms);
  }
  .rating.unverified {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .low {
    color: var(--r-low);
  }
  .mid {
    color: var(--r-mid);
  }
  .good {
    color: var(--r-good);
  }
  .elite {
    color: var(--r-elite);
  }
  .chev {
    width: 0.75rem;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    transition: transform 0.25s var(--ease);
  }
  details[open] .chev {
    transform: rotate(90deg);
  }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.3s var(--ease),
      content-visibility 0.3s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  .evidence {
    padding: 0 0 var(--space-3);
    font-size: 0.875rem;
  }
  .evidence ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .evidence li {
    border: 0;
  }
  .evidence p {
    margin: 0;
    color: var(--muted);
  }
  .flag {
    color: var(--r-mid);
  }
  @keyframes settle {
    from {
      opacity: 0.25;
      transform: translateY(0.35rem);
    }
  }
</style>
