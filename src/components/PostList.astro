---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  empty?: string;
}

const { posts, empty = 'Nothing here yet.' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="muted">{empty}</p>
  ) : (
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}`}>
            <span class="label cat">{post.data.category}</span>
            <span class="title">{post.data.title}</span>
            <span class="desc">{post.data.description}</span>
            <time class="label" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    grid-template-areas:
      'cat title date'
      'cat desc desc';
    column-gap: var(--space-4);
    padding: var(--space-3) 0;
    color: var(--fg);
    text-decoration: none;
  }
  li:first-child a {
    padding-top: 0;
  }
  .cat {
    grid-area: cat;
    padding-top: 0.2rem;
  }
  .title {
    grid-area: title;
    font-weight: 700;
    font-size: 1.0625rem;
    transition: color 0.15s var(--ease);
  }
  a:hover .title {
    color: var(--link);
  }
  .desc {
    grid-area: desc;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  time {
    grid-area: date;
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  @media (max-width: 36rem) {
    a {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'title title'
        'desc desc'
        'cat date';
      row-gap: var(--space-1);
    }
  }
</style>
