---
import { render, type CollectionEntry } from 'astro:content';
import ProbabilityStrip from './ProbabilityStrip.astro';
import { formatDate } from '../lib/content';

interface Props {
  take: CollectionEntry<'takes'>;
}

const { take } = Astro.props;
const { Content } = await render(take);
const { prediction } = take.data;
const outcomeLabel = {
  pending: 'Pending',
  right: 'Called it',
  wrong: 'Wrong',
  void: 'Void',
};
---

<article id={take.id} class="take">
  <header>
    <time class="label" datetime={take.data.date.toISOString()}>{formatDate(take.data.date)}</time>
    <span class="tags">{take.data.tags.map((tag) => <span class="label">#{tag}</span>)}</span>
  </header>
  <div class="body"><Content /></div>
  {
    prediction && (
      <div class="prediction">
        <div class="pred-head">
          <span class="label">Prediction</span>
          <span class:list={['label', 'outcome', prediction.outcome]}>{outcomeLabel[prediction.outcome]}</span>
        </div>
        <p class="claim">{prediction.claim}</p>
        <ProbabilityStrip josh={prediction.confidence} market={prediction.marketProb} />
        <p class="label resolves">Resolves {formatDate(prediction.resolvesBy)}</p>
      </div>
    )
  }
</article>

<style>
  .take {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: var(--space-5);
  }
  .take:first-child {
    padding-top: 0;
  }
  .take:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .tags {
    display: flex;
    gap: var(--space-2);
  }
  .body :global(p) {
    margin: var(--space-2) 0 0;
  }
  .prediction {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--line);
  }
  .pred-head {
    display: flex;
    justify-content: space-between;
  }
  .claim {
    margin: var(--space-1) 0 var(--space-3);
    font-weight: 600;
  }
  .outcome.right {
    color: var(--r-good);
  }
  .outcome.wrong {
    color: var(--r-low);
  }
  .resolves {
    margin: var(--space-2) 0 0;
  }
</style>
