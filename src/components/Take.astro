---
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  take: CollectionEntry<'takes'>;
}

const { take } = Astro.props;
const { Content } = await render(take);
const { prediction } = take.data;
---

<article>
  <div class="meta">
    <time datetime={take.data.date.toISOString()}>{formatDate(take.data.date)}</time>
    {take.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
  </div>
  <Content />
  {
    prediction && (
      <aside class="prediction">
        <strong>Prediction:</strong> {prediction.claim}
        <div class="muted">
          {Math.round(prediction.confidence * 100)}% confident · resolves{' '}
          {formatDate(prediction.resolvesBy)} · {prediction.outcome}
        </div>
      </aside>
    )
  }
</article>

<style>
  article {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .prediction {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    font-size: 0.95rem;
  }
</style>
