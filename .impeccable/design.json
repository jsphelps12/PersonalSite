  "components": [
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The universal container: label-style head on the recess tone, body on panel.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-head\"><h2>Scout report</h2><a href=\"#\">About</a></header><div class=\"ds-panel-body\">Applied AI engineer who'd rather show you the eval than the demo.</div></section>",
      "css": ".ds-panel{background:var(--panel);color:var(--fg);border:1px solid var(--line);border-radius:4px;box-shadow:var(--shadow);font-family:var(--font)}.ds-panel-head{display:flex;justify-content:space-between;align-items:baseline;padding:.75rem 1rem;border-bottom:1px solid var(--line);background:var(--panel-2);border-radius:4px 4px 0 0}.ds-panel-head h2,.ds-panel-head a{margin:0;font-stretch:72%;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em}.ds-panel-head h2{color:var(--fg)}.ds-panel-head a{color:var(--link);text-decoration:none}.ds-panel-head a:hover{text-decoration:underline}.ds-panel-head a:focus-visible{outline:2px solid var(--stripe);outline-offset:2px}.ds-panel-body{padding:1rem;line-height:1.55}"
    },
    {
      "name": "Tab strip",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Section navigation; current tab takes ink and a 3px stripe underline.",
      "html": "<nav class=\"ds-tabs\"><a href=\"#\" aria-current=\"page\">Overview</a><a href=\"#\">Writing</a><a href=\"#\">Takes</a><a href=\"#\">Projects</a></nav>",
      "css": ".ds-tabs{display:flex;gap:.25rem;background:var(--panel);border-bottom:1px solid var(--line);font-family:var(--font)}.ds-tabs a{display:block;padding:.5rem .75rem calc(.5rem + 1px);font-stretch:72%;font-weight:700;font-size:.875rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);text-decoration:none;border-bottom:3px solid transparent;transition:color .2s cubic-bezier(.16,1,.3,1),border-color .2s cubic-bezier(.16,1,.3,1)}.ds-tabs a:hover{color:var(--fg)}.ds-tabs a[aria-current=page]{color:var(--fg);border-bottom-color:var(--stripe)}.ds-tabs a:focus-visible{outline:2px solid var(--stripe);outline-offset:2px}"
    },
    {
      "name": "Skin switch",
      "kind": "chip",
      "refersTo": "phase-option",
      "description": "Segmented radio control naming each time phase; checked takes the stripe.",
      "html": "<div class=\"ds-phase\"><label><input type=\"radio\" name=\"ds-p\" checked><span>Auto</span></label><label><input type=\"radio\" name=\"ds-p\"><span>Night</span></label><label><input type=\"radio\" name=\"ds-p\"><span>Dawn</span></label><label><input type=\"radio\" name=\"ds-p\"><span>Day</span></label></div>",
      "css": ".ds-phase{display:inline-flex;border:1px solid var(--line);border-radius:4px;overflow:hidden;font-family:var(--font)}.ds-phase label{position:relative}.ds-phase input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}.ds-phase span{display:block;padding:.2rem .55rem;font-stretch:72%;font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);transition:background-color .2s,color .2s}.ds-phase label+label span{border-left:1px solid var(--line)}.ds-phase input:hover+span{color:var(--fg)}.ds-phase input:checked+span{background:var(--stripe);color:var(--stripe-ink)}.ds-phase input:focus-visible+span{outline:2px solid var(--stripe);outline-offset:-2px}"
    },
    {
      "name": "Attribute row",
      "kind": "custom",
      "refersTo": "attribute-rating",
      "description": "Disclosure row: band-coloured rating with evidence, muted range when unverified.",
      "html": "<ul class=\"ds-attrs\"><li><details><summary><span class=\"n\">Decisions</span><span class=\"r good\">14</span><svg class=\"c\" viewBox=\"0 0 12 12\"><path d=\"M4 2.5 7.5 6 4 9.5\"/></svg></summary><p class=\"ev\">POST <a href=\"#\">The Ewing Theory and Mbappe</a></p></details></li><li><details><summary><span class=\"n\">Python</span><span class=\"r u\">11&ndash;15</span><svg class=\"c\" viewBox=\"0 0 12 12\"><path d=\"M4 2.5 7.5 6 4 9.5\"/></svg></summary><p class=\"ev\"><b>UNVERIFIED</b> No evidence on the site yet.</p></details></li></ul>",
      "css": ".ds-attrs{list-style:none;margin:0;padding:0;font-family:var(--font);color:var(--fg)}.ds-attrs li{border-bottom:1px solid var(--line)}.ds-attrs summary{display:grid;grid-template-columns:1fr auto .75rem;align-items:center;gap:.5rem;padding:.4rem 0;cursor:pointer;list-style:none}.ds-attrs summary::-webkit-details-marker{display:none}.ds-attrs summary:hover .n{color:var(--link)}.ds-attrs summary:focus-visible{outline:2px solid var(--stripe);outline-offset:2px}.ds-attrs .n{font-size:.9375rem;transition:color .15s}.ds-attrs .r{font-stretch:72%;font-weight:800;font-size:1.125rem;font-variant-numeric:tabular-nums;text-align:right;min-width:1.6rem}.ds-attrs .r.u{color:var(--muted);font-weight:600;font-size:.9375rem}.ds-attrs .good{color:var(--r-good)}.ds-attrs .c{width:.75rem;fill:none;stroke:var(--muted);stroke-width:1.5;transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-attrs details[open] .c{transform:rotate(90deg)}.ds-attrs .ev{margin:0;padding:0 0 .75rem;font-size:.875rem;color:var(--muted)}.ds-attrs .ev b{color:var(--r-mid);font-stretch:72%;font-weight:600;font-size:.75rem;letter-spacing:.06em}.ds-attrs .ev a{color:var(--link)}"
    },
    {
      "name": "Probability strip",
      "kind": "custom",
      "refersTo": "probability-track",
      "description": "Translucent forecaster bands from 50%; overlap deepens where they agree.",
      "html": "<div class=\"ds-prob\"><div class=\"t\"><span class=\"m\"></span><span class=\"b a\" style=\"left:50%;width:22%\"></span><span class=\"b bb\" style=\"left:50%;width:14%\"></span></div><p class=\"lg\"><span><i class=\"k a\"></i>Josh <b>72%</b></span><span><i class=\"k bb\"></i>Market <b>64%</b></span></p></div>",
      "css": ".ds-prob{font-family:var(--font)}.ds-prob .t{position:relative;height:.9rem;background:var(--panel-2);border:1px solid var(--line);border-radius:2px;isolation:isolate}.ds-prob .m{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--muted)}.ds-prob .b{position:absolute;top:0;bottom:0;mix-blend-mode:var(--silk-blend)}.ds-prob .a{background:var(--silk-a)}.ds-prob .bb{background:var(--silk-b)}.ds-prob .lg{display:flex;gap:1rem;margin:.5rem 0 0;font-size:.8125rem;color:var(--muted)}.ds-prob .lg b{color:var(--fg);font-variant-numeric:tabular-nums}.ds-prob .k{display:inline-block;width:.7rem;height:.7rem;margin-right:.35rem;border:1px solid var(--line)}"
    },
    {
      "name": "Form pips",
      "kind": "custom",
      "refersTo": "form-pip",
      "description": "Recent prediction results as lettered squares, newest first.",
      "html": "<ol class=\"ds-pips\"><li class=\"w\"><a href=\"#\">W</a></li><li class=\"l\"><a href=\"#\">L</a></li><li class=\"p\"><a href=\"#\">P</a></li><li class=\"e\"></li></ol>",
      "css": ".ds-pips{display:flex;gap:.5rem;list-style:none;margin:0;padding:0;font-family:var(--font)}.ds-pips a{display:grid;place-items:center;width:2rem;height:2rem;border-radius:3px;font-stretch:72%;font-weight:800;text-decoration:none;color:var(--role-ink)}.ds-pips .w a{background:var(--r-good)}.ds-pips .l a{background:var(--r-low)}.ds-pips .p a{background:var(--panel-2);border:1px solid var(--line);color:var(--fg)}.ds-pips .e{width:2rem;height:2rem;border-radius:3px;border:1px solid var(--line);opacity:.5}.ds-pips a:focus-visible{outline:2px solid var(--stripe);outline-offset:2px}"
    },
    {
      "name": "Post row",
      "kind": "custom",
      "refersTo": "panel-body",
      "description": "Hairline-divided list row: category, title, description, date.",
      "html": "<ul class=\"ds-posts\"><li><a href=\"#\"><span class=\"lb c\">Sports</span><span class=\"tt\">The Ewing Theory and Mbappe</span><span class=\"d\">Do teams get better when the star leaves?</span><span class=\"lb dt\">Oct 15, 2026</span></a></li></ul>",
      "css": ".ds-posts{list-style:none;margin:0;padding:0;font-family:var(--font)}.ds-posts li+li{border-top:1px solid var(--line)}.ds-posts a{display:grid;grid-template-columns:6.5rem 1fr auto;grid-template-areas:'c tt dt' 'c d d';column-gap:1rem;padding:.75rem 0;color:var(--fg);text-decoration:none}.ds-posts a:focus-visible{outline:2px solid var(--stripe);outline-offset:2px}.ds-posts .lb{font-stretch:72%;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding-top:.2rem}.ds-posts .c{grid-area:c}.ds-posts .dt{grid-area:dt;white-space:nowrap}.ds-posts .tt{grid-area:tt;font-weight:700;font-size:1.0625rem;transition:color .15s}.ds-posts a:hover .tt{color:var(--link)}.ds-posts .d{grid-area:d;color:var(--muted);font-size:.9375rem}"
    },
    {
      "name": "Link",
      "kind": "button",
      "refersTo": "panel",
      "description": "Inline link: hairline underline that thickens on hover.",
      "html": "<p class=\"ds-link\">Read the <a href=\"#\">colophon</a> for how this was built.</p>",
      "css": ".ds-link{font-family:var(--font);color:var(--fg)}.ds-link a{color:var(--link);text-decoration-thickness:1px;text-underline-offset:.2em}.ds-link a:hover{text-decoration-thickness:2px}.ds-link a:focus-visible{outline:2px solid var(--stripe);outline-offset:2px;border-radius:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Player Profile",
    "overview": "The site is a Football Manager player-profile screen with Josh as the scouted player. Every surface is a stack of dense, square-shouldered data panels on a flat ground: a full-width profile header carrying a yellow kit stripe, attribute columns rated 1 to 20, a prediction-form row of result pips, and an inbox of takes. Navigation is a tab strip under the club bar, not a menu. Information density is high and deliberate; whitespace is spent between panels, not inside them.\n\nTwo disciplines are borrowed into the world. The skin is a time phase (night, dawn, day) picked from the visitor's clock before first paint unless they choose one; dawn is cobalt with rose. Probabilities render as translucent overlapping bands leaning away from 50%, deepening where forecasters agree. Both are carried entirely by custom properties, so every component works in every skin without knowing which one is live.\n\nCredibility is the brand constraint underneath the game: ratings without evidence show as a range and say \"Unverified\"; placeholder content is flagged in the mid-band colour. No photography, stock, or fabricated imagery; the world is typographic and diagrammatic (pitch map, crest, strips).",
    "keyCharacteristics": [
      "Archivo Variable in two widths: condensed heavy caps for names, labels, tabs and numbers; normal width for prose.",
      "Tabular numerals everywhere a number is compared.",
      "Four rating bands (low, mid, good, elite) as the only semantic colour family.",
      "One accent per skin (the stripe): kit stripe, active tab, checked skin, focus ring, selection.",
      "Flat panels at a single elevation, 4px corners, 1px hairlines."
    ],
    "rules": [
      {
        "name": "The Clock Skin Rule",
        "body": "Components read tokens, never a skin's literal values. Skins are switched on `data-phase` (night, dawn, day); with no phase set, the OS colour scheme picks night or day. A phase is always named in text in the switch, never shown as colour alone.",
        "section": "colors"
      },
      {
        "name": "The One Stripe Rule",
        "body": "The stripe is the only accent. If a new element wants attention, it takes the stripe in one of its established roles or it stays in ink.",
        "section": "colors"
      },
      {
        "name": "The Band Rule",
        "body": "Band colour always accompanies a number, range, letter or word; colour never carries a rating by itself.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "Condensed caps are for names, labels, tabs and numbers; anything a visitor reads as a sentence is normal width and sentence case.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any number that sits in a column or is compared to another number uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The One Level Rule",
        "body": "Panels never stack or lift on hover; there is one elevation and every panel is on it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** take every colour from the skin tokens so a new component works in night, dawn and day without changes.",
      "**Do** colour ratings by the 1-5 / 6-10 / 11-15 / 16-20 bands and always show the number or range alongside.",
      "**Do** show an attribute with no evidence as a muted range and the word \"Unverified\".",
      "**Do** render any probability as translucent bands from 50% using the silk tokens and the skin's blend mode.",
      "**Do** put new content in a panel with a label-style head, or as a hairline-divided row inside one.",
      "**Do** set names, labels, tabs and numbers in condensed caps, and sentences at normal width.",
      "**Do** use the shared expo-out ease (`cubic-bezier(0.16, 1, 0.3, 1)`): 0.6s for skin changes, 0.15-0.3s for hover and disclosure, and honour reduced motion by removing all animation.",
      "**Do** check text on any band or stripe fill clears 4.5:1 in all three skins."
    ],
    "donts": [
      "**Don't** use photography, stock or generated imagery; the world is type, data and diagrams.",
      "**Don't** introduce a second accent, gradients, or tinted panel backgrounds beyond `panel` and `panel-2`.",
      "**Don't** round corners past 4px or lift panels on hover.",
      "**Don't** draw solid probability bars or pie charts for forecasts.",
      "**Don't** set prose in condensed caps or labels in sentence-case normal width.",
      "**Don't** mark a skin, rating or outcome by colour alone."
    ]
  }
}